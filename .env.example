# Скопируйте в .env и заполните ОДИН из вариантов.
# Без ключа проект работает на детерминированном fallback (см. README).

# Вариант 1 — Anthropic (Claude)
# ANTHROPIC_API_KEY=sk-ant-...

# Вариант 2 — OpenAI
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o        # по умолчанию gpt-4o; можно gpt-4o-mini (дешевле)

# Вариант 3 — Ollama (локально, без ключа)
# LLM_PROVIDER=ollama
# OLLAMA_MODEL=llama3.1

# Явный выбор провайдера (anthropic|openai|ollama|fallback). По умолчанию — авто.
# LLM_PROVIDER=anthropic
